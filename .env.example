# -----------------------------------------------------------------------------
# Corellian Spike Sabacc — Environment Configuration
# -----------------------------------------------------------------------------

# Network & Container Runtime
PORT="3000"
TZ="Etc/UTC"
PUID="1000"
PGID="1000"
CONFIG_DIR="./data"

# Reverse Proxy & Public URL
# Set TRUST_PROXY="true" behind Traefik, Caddy, Nginx, or Cloudflare Tunnel.
TRUST_PROXY="false"
# Used for clickable Join links in Discord embeds and default OIDC callback URLs:
# PUBLIC_URL="https://sabacc.example.com"
# Comma-separated Socket.IO origin allowlist (leave unset for LAN + same-origin):
# ALLOWED_ORIGINS="https://sabacc.example.com"

# Security & Access Control
# Random secret used to sign HttpOnly auth cookies (recommended in production):
# SESSION_SECRET="generate-a-long-random-hex-string"
# Lock the entire web UI and Socket.IO server behind a shared password:
# SITE_PASSWORD=""
# Unlock the /admin UI (shield icon) to edit settings, webhooks, and rooms live:
# ADMIN_PASSWORD=""

# OpenID Connect (OIDC — Authentik, Authelia, Keycloak, Pocket-ID, etc.)
# Callback URL to register in your provider: ${PUBLIC_URL}/api/auth/oidc/callback
# OIDC_ISSUER_URL="https://auth.example.com/application/o/sabacc"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_PROVIDER_NAME="Authentik"
# OIDC_REQUIRE_AUTH="false"
# OIDC_ALLOWED_GROUP=""
# OIDC_ADMIN_GROUP="sabacc-admins"
# OIDC_ADMIN_EMAILS="admin@example.com"

# Discord Webhook Notifications
# Automatically posts rich embeds when multiplayer tables open or jackpots hit:
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
DISCORD_NOTIFY_ROOMS="true"
DISCORD_NOTIFY_JACKPOTS="true"
DISCORD_ALLOW_SHARE="true"

# Default Table Policy
DEFAULT_STAKES="medium"
PUBLIC_LOBBY="true"
LOCK_CREDITS="false"
SERVER_NOTICE=""
