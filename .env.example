# PORT: Port the game server listens on (default: 3000)
PORT="3000"

# ALLOWED_ORIGINS: Comma-separated origin allowlist for Socket.IO.
# Leave unset for LAN play: loopback, private network ranges, and the packaged
# desktop/Android clients are allowed. Set it when exposing the server publicly,
# and then ONLY these origins may connect.
# ALLOWED_ORIGINS="https://sabacc.example.com"

# STATIC_DIR: Serve a prebuilt static bundle from this directory instead of
# running Next.js. Set automatically by the Docker image and the host binary.
# STATIC_DIR="/app/web"

# NEXT_PUBLIC_SERVER_URL: Bake a fixed server address into the client build.
# Only needed for packaged clients that should not ask for a host address.
# NEXT_PUBLIC_SERVER_URL="https://sabacc.example.com"
